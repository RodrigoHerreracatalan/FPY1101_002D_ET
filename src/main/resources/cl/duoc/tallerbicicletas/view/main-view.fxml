<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.duoc.tallerbicicletas.controller.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <VBox spacing="10.0" prefWidth="340.0">
            <Label text="Registro de bicicletas">
                <font>
                    <Font name="System Bold" size="18.0"/>
                </font>
            </Label>

            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="120.0" prefWidth="125.0"/>
                    <ColumnConstraints hgrow="ALWAYS" prefWidth="200.0"/>
                </columnConstraints>

                <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="cmbTipo" maxWidth="Infinity" promptText="Seleccione..."
                          GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Año de fabricación:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtAnio" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Peso (kg):" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtPeso" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane>


            <TitledPane fx:id="paneElectrica" collapsible="false" text="Datos de la bicicleta eléctrica" disable="true">
                <VBox spacing="8.0">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label minWidth="110.0" text="Autonomía (km):"/>
                        <TextField fx:id="txtAutonomia" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <CheckBox fx:id="chkBateriaCertificada" text="Batería certificada">
                        <VBox.margin>
                            <Insets left="120.0"/>
                        </VBox.margin>
                    </CheckBox>
                    <CheckBox fx:id="chkGarantiaExtendida" text="Garantía extendida">
                        <VBox.margin>
                            <Insets left="120.0"/>
                        </VBox.margin>
                    </CheckBox>
                </VBox>
            </TitledPane>


            <TitledPane fx:id="paneMontanya" collapsible="false" text="Datos de la bicicleta de montaña" disable="true">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label minWidth="110.0" text="Suspensiones:"/>
                    <TextField fx:id="txtSuspensiones" HBox.hgrow="ALWAYS"/>
                </HBox>
            </TitledPane>

            <HBox alignment="CENTER_RIGHT">
                <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#onRegistrarClick"
                        prefWidth="90.0" text="Registrar"/>
            </HBox>
        </VBox>


        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <TableView fx:id="tblBicicletas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo"/>
                    <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código"/>
                    <TableColumn fx:id="colAnio" prefWidth="70.0" text="Año"/>
                    <TableColumn fx:id="colPeso" prefWidth="85.0" text="Peso (kg)"/>
                    <TableColumn fx:id="colCosto" prefWidth="125.0" text="Costo mantención"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_LEFT">
                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#onEliminarClick"
                        prefWidth="85.0" text="Eliminar"/>
            </HBox>
        </VBox>
    </HBox>


    <Label fx:id="lblMensaje" wrapText="true">
        <font>
            <Font name="System Bold" size="13.0"/>
        </font>
    </Label>
</VBox>